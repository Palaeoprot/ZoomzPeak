    title: "LADO: Linked Archaeological Data Ontology"
    version: "1.1"
    authors:
      - family-names: Thiery
        given-names: Florian
      - family-names: Mees
        given-names: Allard W.
    doi: "10.5281/zenodo.15477358"
    repository-code: "https://github.com/archaeolink/lado"
    license: CC-BY-4.0
    year: 2025
  - type: standard
    title: "mzPeak: an open format for mass spectrometry data"
    institution:
      name: "HUPO Proteomics Standards Initiative"
    url: "https://www.mzpeak.org/"
  - type: standard
    title: "PSI-MS controlled vocabulary"
    institution:
      name: "HUPO Proteomics Standards Initiative"
    url: "https://www.ebi.ac.uk/ols4/ontologies/ms"
