# Normalise line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Explicitly binary — never munge these
*.png binary
*.ico binary
*.pdf binary
*.parquet binary
*.zip binary
*.mzpeak binary

# Vocabulary, spec and data files stay LF everywhere
*.yaml text eol=lf
*.yml  text eol=lf
*.ttl  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.cff  text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
